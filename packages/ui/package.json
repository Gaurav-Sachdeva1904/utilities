{
    "name": "@utilities/ui",
    "version": "1.0.0",
    "license": "MIT",
    "main": "./dist/ui.umd.js",
    "module": "./dist/ui.es.js",
    "types": "./dist/index.d.ts",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/ui.es.js",
            "require": "./dist/ui.umd.js"
        },
        "./styles.css": {
            "default": "./dist/ui.css"
        }
    },
    "scripts": {
        "lint": "yarn eslint",
        "lint:fix": "yarn eslint:fix",
        "eslint": "eslint ./src --ext .ts,.js --config ./eslint.config.js",
        "eslint:fix": "eslint ./src --ext .ts,.js, --config ./eslint.config.js --fix",
        "lint:style": "stylelint '**/*.{css,scss}' --config .stylelintrc.json",
        "lint:style:fix": "stylelint '**/*.{css,scss}' --fix --config .stylelintrc.json",
        "generate:theme-colors": "node ./scripts/generate-theme-colors.mjs",
        "build": "yarn generate:theme-colors && vite build",
        "dev": "yarn generate:theme-colors && vite build --watch",
        "dev:types": "yarn generate:theme-colors && vite build --plugin dts --watch",
        "storybook:build": "yarn generate:theme-colors && storybook build",
        "storybook:start": "yarn generate:theme-colors && storybook dev -p 6006"
    },
    "dependencies": {
        "@radix-ui/react-dialog": "^1.1.14",
        "@radix-ui/react-icons": "^1.3.2",
        "@radix-ui/react-tabs": "^1.1.12",
        "@radix-ui/react-toast": "^1.2.14",
        "@radix-ui/themes": "^3.2.1",
        "@utilities/configs": "^1.0.0",
        "lucide-react": "^0.525.0",
        "radix-ui": "^1.4.2",
        "react-colorful": "^5.6.1",
        "react-day-picker": "^9.13.0"
    },
    "peerDependencies": {
        "react": "^19.1.0",
        "react-dom": "^19.1.0"
    },
    "eslintConfig": {
        "extends": [
            "plugin:storybook/recommended"
        ]
    },
    "devDependencies": {
        "@storybook/addon-docs": "^9.0.15",
        "@storybook/addon-onboarding": "^9.0.15",
        "@storybook/react-vite": "^9.0.15",
        "@types/react": "^19.1.8",
        "@types/react-dom": "^19.1.6",
        "@vitejs/plugin-react": "^4.6.0",
        "eslint-plugin-storybook": "^9.0.15",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "storybook": "^9.0.15",
        "vite": "^7.0.2",
        "vite-plugin-dts": "^4.5.4",
        "vite-tsconfig-paths": "^5.1.4"
    }
}
